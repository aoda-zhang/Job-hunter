{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Job Apply blocked-field queue",
  "description": "Local working state for job-apply. One object per blocked submission. Never published and never copied from job-hunter.config.json applicant values.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "updatedAt", "blockers"],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "updatedAt": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "blockers": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "date", "company", "role", "field", "kind", "reason", "status", "answer"],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^b-[0-9]{3,}$"
          },
          "date": {
            "type": "string",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
          },
          "company": {
            "type": "string",
            "minLength": 1
          },
          "role": {
            "type": ["string", "null"]
          },
          "field": {
            "type": ["string", "null"],
            "description": "Exact field label, or null when the blocker is not a single field."
          },
          "kind": {
            "enum": ["field", "login", "captcha", "upload", "infrastructure", "unavailable"]
          },
          "reason": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "enum": ["open", "answered", "fixed"]
          },
          "answer": {
            "type": ["string", "null"]
          },
          "pass": {
            "enum": ["main", "both-lan"],
            "description": "Which run part produced the blocker. Absent means the main pass."
          }
        },
        "allOf": [
          {
            "if": {
              "properties": { "status": { "const": "open" } }
            },
            "then": {
              "properties": { "answer": { "type": "null" } }
            }
          },
          {
            "if": {
              "properties": { "status": { "enum": ["answered", "fixed"] } }
            },
            "then": {
              "properties": {
                "answer": { "type": "string", "minLength": 1 }
              }
            }
          }
        ]
      }
    }
  }
}
