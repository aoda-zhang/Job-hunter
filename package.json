{
  "name": "job-hunter",
  "version": "0.2.0",
  "private": true,
  "description": "Configurable AI-assisted job discovery and matching across countries and roles",
  "type": "module",
  "engines": { "node": ">=22" },
  "scripts": {
    "dev": "tsx src/cli.ts",
    "typecheck": "tsc --noEmit",
    "config:check": "tsx src/cli.ts config:check",
    "db:init": "tsx src/cli.ts db:init",
    "discover": "tsx src/cli.ts discover",
    "report": "tsx src/cli.ts report",
    "interview:prepare": "tsx src/cli.ts interview:prepare"
  },
  "dependencies": {
    "better-sqlite3": "^12.2.0",
    "dotenv": "^16.4.7",
    "playwright": "^1.55.0",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.15.30",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  }
}