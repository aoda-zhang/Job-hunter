{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Job Hunter Search Configuration",
  "type": "object",
  "additionalProperties": false,
  "required": ["search"],
  "properties": {
    "$schema": { "type": "string" },
    "search": {
      "type": "object",
      "additionalProperties": false,
      "required": ["countries", "roles", "lookbackHours", "maxResultsPerSource", "sources"],
      "properties": {
        "countries": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 2 } },
        "roles": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 2 } },
        "locations": { "type": "array", "items": { "type": "string" } },
        "workModes": { "type": "array", "items": { "type": "string", "enum": ["remote", "hybrid", "onsite", "flexible"] } },
        "lookbackHours": { "type": "integer", "minimum": 1 },
        "maxResultsPerSource": { "type": "integer", "minimum": 1 },
        "sources": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 2 } },
        "excludeKeywords": { "type": "array", "items": { "type": "string" } }
      }
    }
  }
}
